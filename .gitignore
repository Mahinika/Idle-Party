migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Obsidian vault UI (local). Not used for project docs — leave ignored if present.
.obsidian/



# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local simulation reports
/tool/out/

# Local art sources for tool/extend_world_path_*.py.
# These live outside assets/ so Flutter does not bundle them into the app.
/tool/art_backups/*
# The launcher/store icon source stays tracked (README + Play listing use it).
!/tool/art_backups/app_icon.png

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing (never commit secrets)
/android/key.properties
/android/admob.properties
*.jks
*.keystore

# --- Legal hygiene: never commit other games' binaries or dumps ---
*.apk
*.aab
*.ipa
*.obb
*.swf
*.dex
.tmp_is2_apk/
.tmp_is2_ui/
.tmp_*_apk/
.tmp_*_dump/
idle-sword*
IdleSword*
