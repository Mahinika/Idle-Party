<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark launch — avoid white flash before Flutter paints LoadingSplash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/splash_ink</item>
        <item name="android:navigationBarColor">@color/splash_ink</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ink</item>
        <item name="android:statusBarColor">@color/splash_ink</item>
        <item name="android:navigationBarColor">@color/splash_ink</item>
    </style>
</resources>
