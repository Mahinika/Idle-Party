<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup keeps the save-file copies only. Shared preferences,
     databases, and external files (ad id, Play credentials) stay out. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="idle_party_backup/slot_0.json" />
        <include domain="file" path="idle_party_backup/slot_1.json" />
        <include domain="file" path="idle_party_backup/slot_2.json" />
        <include domain="file" path="idle_party_backup/slot_3.json" />
        <include domain="file" path="idle_party_backup/slot_4.json" />
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="idle_party_backup/slot_0.json" />
        <include domain="file" path="idle_party_backup/slot_1.json" />
        <include domain="file" path="idle_party_backup/slot_2.json" />
        <include domain="file" path="idle_party_backup/slot_3.json" />
        <include domain="file" path="idle_party_backup/slot_4.json" />
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
